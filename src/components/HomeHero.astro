---
import { site } from '../data/site';

const primaryContact = site.socialLinks.find((link) => link.label === 'Email')?.href ?? '#';
---

<section class="mx-auto mt-10 flex max-w-4xl animate-fade-up flex-col items-center text-center">
	<div class="flex flex-col items-center gap-5">
		<div class="flex flex-col items-center gap-4 sm:flex-row sm:gap-5">
			<img
				class="h-28 w-28 rounded-full border-4 border-white object-cover shadow-[0_10px_30px_rgba(15,23,42,0.10)] sm:h-32 sm:w-32"
				src={site.avatarUrl}
				alt="Portrait of Faturahman Yudanto"
				loading="eager"
			/>
		</div>

		<div class="space-y-4">
			<p class="text-lg text-stone-500">Hello, I'm</p>
			<h1 class="m-2 text-5xl leading-none font-semibold tracking-[-0.08em] text-stone-950 sm:text-6xl lg:text-7xl">
				{site.title}
			</h1>
			<p class="mx-auto max-w-3xl text-lg leading-9 text-stone-700 sm:text-xl">
				{site.intro}
			</p>
		</div>

		<div class="mt-2 flex w-full max-w-md flex-col justify-center gap-3 sm:flex-row">
			<a
				class="inline-flex items-center justify-center rounded-full bg-stone-950 px-6 py-3.5 text-base font-semibold text-stone-50 transition hover:-translate-y-0.5 hover:bg-stone-800"
				href="/projects"
			>
				View Projects
			</a>
			<a
				class="inline-flex items-center justify-center rounded-full border border-stone-900/15 bg-white/70 px-6 py-3.5 text-base font-semibold text-stone-800 transition hover:-translate-y-0.5 hover:border-stone-900/25 hover:bg-white"
				href={primaryContact}
			>
				Get in Touch
			</a>
		</div>
	</div>
</section>
