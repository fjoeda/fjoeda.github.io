---
import { site } from '../data/site';

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
	href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);
---

<nav class="sticky top-0 z-10 site-nav" aria-label="Primary">
	<div class="flex justify-center px-4 pt-6 sm:pt-6">
		<div class="flex items-center gap-1 rounded-full border border-gray-400/10 bg-white/85 px-2 py-2 shadow-[0_8px_24px_rgba(15,23,42,0.06)] backdrop-blur">
			<a
				class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-black text-[0.68rem] font-semibold tracking-[0.2em] text-white transition hover:bg-gray-800 focus-visible:bg-gray-800"
				href="/"
			>
				FY
			</a>
			<ul class="flex items-center gap-1">
			{
				site.navItems.map((item) => (
					<li>
						<a
							class:list={[
								'inline-flex items-center rounded-full px-3 py-1.5 text-sm font-medium text-gray-600 transition hover:text-white hover:bg-gray-800 focus-visible:text-black',
								{ 'text-black': isActive(item.href) },
							]}
							href={item.href}
						>
							{item.label}
						</a>
					</li>
				))
			}
			</ul>
		</div>
	</div>
</nav>
