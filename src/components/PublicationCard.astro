---
type Props = {
	year: number;
	title: string;
	authors?: string[];
	presentedAt?: string;
	href: string;
};

const { year, title, authors = [], presentedAt, href } = Astro.props;
const authorsLabel = authors.length > 0 ? authors.join(', ') : 'Authors unavailable';
---

<a
	class="group block rounded-[1.6rem] border border-gray-300 bg-white/75 p-6 shadow-[0_12px_30px_rgba(15,23,42,0.05)] transition-transform duration-200 hover:-translate-y-0.5 hover:border-gray-400 hover:shadow-[0_18px_36px_rgba(15,23,42,0.08)]"
	href={href}
>
	<p class="m-0 text-[0.72rem] font-bold uppercase tracking-[0.2em] text-black">{year}</p>
	<h3 class="mt-2 mb-2 text-xl leading-tight font-semibold tracking-[-0.02em] text-black group-hover:text-gray-800">
		{title}
	</h3>
	<p class="m-0 leading-7 text-gray-700">{authorsLabel}</p>
	{presentedAt && <p class="m-0 text-gray-700">{presentedAt}</p>}
	<p class="mt-3 text-sm font-semibold text-black">Read abstract</p>
</a>
