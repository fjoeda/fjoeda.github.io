---
import { getCollection } from 'astro:content';
import ProjectCard from '../../components/ProjectCard.astro';
import PageIntro from '../../components/PageIntro.astro';
import { projectIndexIntro } from '../../data/site';
import Layout from '../../layouts/Layout.astro';

const projects = (await getCollection('projects')).sort((left, right) => {
	const leftTime = left.data.publishDate?.getTime() ?? 0;
	const rightTime = right.data.publishDate?.getTime() ?? 0;
	return rightTime - leftTime;
});
---

<Layout title="Projects | Faturahman Yudanto" description="A selection of recent projects, experiments, and write-ups related to AI development and research.">
	<PageIntro
		eyebrow="Portfolio"
		title="Projects"
		description="A selection of recent projects, experiments, and write-ups related to AI development and research."
	/>

	<section class="mt-8 grid animate-fade-up gap-4 [animation-delay:120ms] md:grid-cols-2 xl:grid-cols-3">
		{
			projects.length > 0 ? (
				projects.map((project) => (
					<ProjectCard
						title={project.data.title}
						excerpt={project.data.excerpt}
						tags={project.data.tags}
						hasDemo={Boolean(project.data.demoUrl)}
						href={`/projects/${project.id}/`}
					/>
				))
			) : (
				<p class="rounded-[1.8rem] border border-gray-300 bg-white/70 p-6 text-gray-700 shadow-[0_24px_60px_rgba(34,40,35,0.08)] backdrop-blur md:col-span-2 xl:col-span-3">
					No project posts found yet. Add markdown files in <code>src/content/projects</code> to populate this page.
				</p>
			)
		}
	</section>
</Layout>
