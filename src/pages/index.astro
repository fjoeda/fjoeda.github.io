---
import HomeHero from '../components/HomeHero.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';
import Layout from '../layouts/Layout.astro';

const projectPosts = (await getCollection('projects'))
	.sort((left, right) => {
		const leftTime = left.data.publishDate?.getTime() ?? 0;
		const rightTime = right.data.publishDate?.getTime() ?? 0;
		return rightTime - leftTime;
	})
	.slice(0, 2);
---

<Layout title={`${site.title} | AI Developer`} description={site.description}>
	<HomeHero />

