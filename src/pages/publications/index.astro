---
import { getCollection } from 'astro:content';
import PageIntro from '../../components/PageIntro.astro';
import PublicationCard from '../../components/PublicationCard.astro';
import Layout from '../../layouts/Layout.astro';

const pageTitle = 'Publications | Faturahman Yudanto';
const pageDescription =
	'Recent publications and research interests in NLP, LLMs, and applied AI.';

const publications = (await getCollection('publication')).sort((left, right) => right.data.year - left.data.year);
---

<Layout title={pageTitle} description={pageDescription}>
	<PageIntro
		eyebrow="Academic profile"
		title="Publications"
		description="A snapshot of recent publication activity and active research directions."
	/>

	<section class="mt-8 animate-fade-up [animation-delay:180ms]">
		<h2 class="mb-4 text-3xl leading-tight font-semibold tracking-[-0.05em] text-black">Recent Publications & Presented Works</h2>
		<div class="grid gap-4">
			{
				publications.map((item) => (
					<PublicationCard
						year={item.data.year}
						title={item.data.title}
						authors={item.data.authors}
						presentedAt={item.data.presentedAt}
						href={`/publications/${item.id}/`}
					/>
				))
			}
		</div>
		{publications.length === 0 && (
			<p class="rounded-[1.8rem] border border-gray-300 bg-white/70 p-6 text-gray-700 shadow-[0_24px_60px_rgba(34,40,35,0.08)] backdrop-blur">
				No publication posts found yet. Add markdown files in <code>src/content/publication</code> to populate this page.
			</p>
		)}
	</section>
  
	<div class="mt-12 animate-fade-up [animation-delay:220ms] flex justify-center">
		<a
			class="inline-flex items-center rounded-full border border-gray-300 bg-black px-5 py-2.5 text-sm font-semibold text-white no-underline shadow-[0_12px_30px_rgba(34,40,35,0.08)] transition-transform duration-200 hover:-translate-y-0.5 hover:bg-gray-800"
			href="https://scholar.google.com/citations?user=naZctIoAAAAJ&hl=en"
			target="_blank"
			rel="noreferrer"
		>
			See more on my Google Scholar profile
		</a>
	</div>
</Layout>
